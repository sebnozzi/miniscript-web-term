{
  "name": "miniscript-web-term",
  "version": "0.3.0",
  "description": "A web-based MiniScript terminal runner",
  "author": "Joe Strout",
  "contributors": [
    "Sebastian Nozzi"
  ],
  "license": "MIT",
  "keywords": [
    "miniscript",
    "xtermjs",
    "runner",
    "commandline",
    "terminal"
  ],
  "files": [
    "dist",
    "lib",
    "example",
    "index.html"
  ],
  "scripts": {
    "build": "npm run build-wasm && npm run build-js",
    "build-js": "esbuild src/index.ts --bundle --sourcemap --outfile=dist/miniscript-web-term.js",
    "build-wasm": "wasm/build.sh",
    "build-watch": "esbuild src/index.ts --bundle --sourcemap --outfile=dist/miniscript-web-term.js --watch"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.4",
    "esbuild": "0.19.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@xterm/xterm": "^5.4.0-beta.1",
    "xterm-readline": "^1.1.1"
  }
}
